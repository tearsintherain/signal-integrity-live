GEMINI_API_KEY=your_gemini_api_key_here

# Select the active audit database: cloud or local
CLICKHOUSE_MODE=cloud

# ClickHouse Cloud (HTTPS)
CLICKHOUSE_CLOUD_HOST=your_cloud_host_here
CLICKHOUSE_CLOUD_PORT=8443
CLICKHOUSE_CLOUD_USER=your_cloud_username_here
CLICKHOUSE_CLOUD_PASSWORD=your_cloud_password_here
CLICKHOUSE_CLOUD_DB=signal_integrity

# Local ClickHouse (HTTP by default)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=signal_app
CLICKHOUSE_PASSWORD=your_local_clickhouse_password_here
CLICKHOUSE_DB=signal_integrity
CLICKHOUSE_SECURE=false
